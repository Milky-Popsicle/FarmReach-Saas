@startuml
title Buyer marketplace and order placement
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor Buyer
boundary "Browser\n(Blade UI)" as Browser
control "Laravel Router\n+ auth middleware" as Router
control MarketplaceController
control CartController
entity Product
entity Order
entity OrderItem
entity Payment
database "Relational database" as DB
collections "Database notifications" as Notifications

Buyer -> Browser: Browse marketplace
Browser -> Router: GET /marketplace
Router -> MarketplaceController: index(search / filters)
MarketplaceController -> Product: Query active, in-stock products
Product -> DB: SELECT products and relations
DB --> Product: Product rows
Product --> MarketplaceController: Results
MarketplaceController --> Browser: Render marketplace.index
Browser --> Buyer: Product listings

Buyer -> Browser: Add product and quantity
Browser -> Router: POST /cart/add
Router -> CartController: add(request)
CartController -> CartController: Validate product_id, quantity, order_type
CartController -> Product: Load product and farmer
Product -> DB: SELECT product and farmer
DB --> Product: Product data
Product --> CartController: Current status, stock, owner
alt Inactive, own listing, or insufficient stock
  CartController --> Browser: Return error; do not add
else Product is eligible
  CartController -> CartController: Update cart in session
  CartController --> Browser: Cart updated
end

Buyer -> Browser: Proceed to checkout
Browser -> Router: GET /checkout
Router -> Router: Require authenticated session
Router -> CartController: checkout()
CartController -> Product: Refresh cart prices and product data
Product -> DB: SELECT current product data
DB --> Product: Current products
Product --> CartController: Refreshed session cart
CartController --> Browser: Render checkout form

Buyer -> Browser: Submit delivery and payment choices
Browser -> Router: POST /checkout
Router -> Router: Require authenticated session
Router -> CartController: placeOrder(request)
CartController -> CartController: Validate cart and checkout fields
note right of CartController
  Delivery address is required for delivery.
  Payment selection is saved as a pending record;
  no gateway charge is made.
end note
CartController -> DB: BEGIN TRANSACTION
CartController -> Product: Lock selected products; recheck active, owner, stock
Product -> DB: SELECT ... FOR UPDATE
DB --> Product: Locked product rows
Product --> CartController: Validated products

alt Product unavailable, own listing, or stock changed
  CartController -> DB: ROLLBACK
  CartController --> Browser: Return validation/domain error
else All selected products pass checks
  loop Once per farmer represented in cart
    CartController -> Order: Create pending order for that farmer
    Order -> DB: INSERT orders
    DB --> Order: Order ID
    loop For each item belonging to this farmer
      CartController -> Product: Decrement available quantity
      Product -> DB: UPDATE products.quantity
      CartController -> OrderItem: Create order line
      OrderItem -> DB: INSERT order_items
    end
    CartController -> Payment: Create pending payment record
    Payment -> DB: INSERT payments
  end
  CartController -> DB: COMMIT
  CartController -> Notifications: Notify each farmer of new order
  Notifications -> DB: INSERT notifications
  DB --> Notifications: Stored notification
  CartController -> CartController: Remove ordered items from session cart
  CartController --> Browser: Redirect to buyer orders
  Browser --> Buyer: Show order placed confirmation
end
@enduml
